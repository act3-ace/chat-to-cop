# chat-to-cop environment variables
#
# Copy to .env and edit. Docker Compose and pydantic-settings both read these.
# All variables use the CHAT_TO_COP_ prefix.

# --- IRC live mode ---
# WebSocket URL of the IRC server. Set this to enable live extraction.
# Omit (or leave empty) to use file replay mode instead.
# CHAT_TO_COP_IRC_URL=ws://10.5.185.72:8097

# Comma-separated IRC channels to join. Defaults to the DASH 3 channel list.
# CHAT_TO_COP_IRC_CHANNELS=#c2_coord,#fires,#isr_reports,#jprc,#stt_C2Coord,#stt_hydroBMA,#stt_crusherBMA,#stt_mesquiteBMA,#stt_taipanBMA,#vegas_internal

# --- LLM backend ---
# OpenAI-compatible API endpoint (Ollama, vLLM, LiteLLM, cloud proxies).
CHAT_TO_COP_LLM_URL=http://127.0.0.1:11434/v1

# Primary model name.
CHAT_TO_COP_LLM_MODEL=qwen2.5:7b

# API key (not needed for Ollama).
# CHAT_TO_COP_LLM_API_KEY=not-needed

# Per-call LLM timeout in seconds (increase for cold starts).
# CHAT_TO_COP_LLM_TIMEOUT=120

# Context window size for Ollama models.
# CHAT_TO_COP_LLM_NUM_CTX=8192

# Hard wall-clock cap (seconds) on a single extract call.
# CHAT_TO_COP_LLM_EXTRACT_HARD_TIMEOUT=45

# --- Fallback model ---
# Smaller/faster model used when the primary is slow or erroring.
CHAT_TO_COP_FALLBACK_MODEL=qwen2.5:3b

# Fallback endpoint (can be same as primary).
# CHAT_TO_COP_FALLBACK_URL=http://127.0.0.1:11434/v1

# Fallback timeout in seconds.
# CHAT_TO_COP_FALLBACK_TIMEOUT=30

# --- World state store ---
# SQLite database path.
CHAT_TO_COP_DB_PATH=data/world_state.db

# --- CoP REST API writer ---
# CoP REST API base URL. Empty string = dry-run mode (log only).
# CHAT_TO_COP_COP_API_URL=

# Minimum confidence for AUTO write (written immediately).
# CHAT_TO_COP_COP_AUTO_THRESHOLD=0.95

# Minimum confidence for FLAGGED write. Below this -> HUMAN review.
# CHAT_TO_COP_COP_FLAG_THRESHOLD=0.5

# HTTP timeout for CoP writes in seconds.
# CHAT_TO_COP_COP_WRITE_TIMEOUT=10

# --- Agent settings ---
# Max messages in conversation window.
# CHAT_TO_COP_WINDOW_SIZE=50

# Enable speaker model learning (default OFF per RQ1 results).
# CHAT_TO_COP_USE_SPEAKER_MODELS=false

# --- Circuit breaker ---
# Consecutive failures before circuit opens.
# CHAT_TO_COP_CIRCUIT_FAIL_MAX=3

# Seconds before circuit breaker retries.
# CHAT_TO_COP_CIRCUIT_COOLDOWN=30

# --- Calibration ---
# Path to calibration model JSON. Empty = no calibration.
# CHAT_TO_COP_CALIBRATION_MODEL=

# --- Metrics ---
CHAT_TO_COP_METRICS=true
